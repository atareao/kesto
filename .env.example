# Kesto — plantilla de variables de entorno del despliegue.
#
# Copia este fichero a `.env` (nunca lo versiones) y rellena los valores.
# `compose.yaml` exige KESTO_MASTER_KEY, las tres OIDC_* y KESTO_SECRET
# (`${VAR:?}`): sin cualquiera de ellas no levanta el servicio.

# ── Obligatoria SIEMPRE ────────────────────────────────────────────────────
# Clave maestra del cifrado en reposo (se deriva con HKDF-SHA256). Sin ella el
# arranque falla. Rotarla deja ilegibles los secretos ya guardados.
# Mínimo 32 caracteres: una clave más corta —o VACÍA— IMPIDE el arranque.
KESTO_MASTER_KEY=

# ── Despliegue en producción ───────────────────────────────────────────────
# gid del grupo dueño del socket del daemon en el host (`getent group docker`).
# El contenedor corre como uid/gid 10001 y necesita ese grupo para abrir
# /var/run/docker.sock. Si no lo defines se usa 10001, que vale para el modo de
# desarrollo y para Podman rootless (donde el socket pertenece al usuario).
# DOCKER_GID=

# ── Modo OIDC: las tres OIDC_* van juntas o ninguna ────────────────────────
# `compose.yaml` EXIGE estas cuatro: sin las tres `OIDC_*` y `KESTO_SECRET` el
# servicio no levanta. LAS TRES `OIDC_*` VAN JUNTAS: con las tres presentes el
# modo es OIDC; con ninguna, modo de desarrollo (`disabled`); con unas sí y
# otras no, el arranque FALLA. En modo OIDC, `KESTO_SECRET` es obligatoria
# (clave de firma de la sesión; rotarla invalida las sesiones vivas) y mide
# también 32 caracteres como mínimo —una más corta o vacía IMPIDE el arranque—.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# KESTO_SECRET=

# ── Modo de desarrollo: solo local, nunca en un despliegue expuesto ─────────
# Sin ninguna `OIDC_*` el modo es el de desarrollo, y hay que autorizarlo con
# `KESTO_ALLOW_INSECURE=1`: sin el permiso —o con `0`— el arranque FALLA, y
# cualquier otro valor es error de arranque. Ese modo exige además que
# `BIND_ADDRESS` sea de loopback (p. ej. `127.0.0.1:8080`), así que no se puede
# publicar el puerto. Déjala COMENTADA salvo para desarrollo.
# KESTO_ALLOW_INSECURE=1

# ── Endurecimiento (opcional) ──────────────────────────────────────────────
# Cabecera HSTS (Strict-Transport-Security). En un despliegue con un proxy que
# termina el TLS, déjala comentada: la HSTS la emite el proxy. Descoméntala
# para que la emita la propia Kesto en TODAS sus respuestas. Un valor entero
# (segundos) ≥ 0. Si la defines vacía o no numérica, el arranque FALLA.
# KESTO_HSTS_MAX_AGE=31536000
